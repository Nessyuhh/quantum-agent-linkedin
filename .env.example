# A definir en secrets GitHub, jamais commite

# --- Redaction -------------------------------------------------------------
# Laisse LLM_PROVIDER vide : l'agent prend Gemini si GOOGLE_API_KEY est la,
# sinon Claude. Mets "claude" pour forcer la bascule meme si les deux cles
# sont presentes.
LLM_PROVIDER=
GOOGLE_API_KEY=
GOOGLE_MODEL=               # vide = le plus recent Flash disponible
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # vide = le plus recent disponible

# --- LinkedIn --------------------------------------------------------------
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=        # urn:li:person:xxxx
LINKEDIN_ORG_URN=           # phase 4, page entreprise
LINKEDIN_VERSION=202608

# --- Telegram --------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

POSTS_PER_RUN=3

# --- Local uniquement, pour scripts/auth_linkedin.py -----------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
